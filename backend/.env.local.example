# Local development — copy to backend/.env:
#   cp backend/.env.local.example backend/.env

SECRET_KEY=local-dev-only-change-me

DEBUG=True

# Leave DATABASE_URL empty to use DB_* below (local PostgreSQL)
DATABASE_URL=

DB_NAME=bhealth_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=127.0.0.1,localhost

DJANGO_SUPERUSER_USERNAME=lumina-admin
DJANGO_SUPERUSER_EMAIL=admin@lumina.local
DJANGO_SUPERUSER_PASSWORD=dashboard_admin_test
