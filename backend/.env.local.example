# Local development — copy to backend/.env:
#   cp backend/.env.local.example backend/.env
#
# Requires PostgreSQL with database bhealth_db (user postgres).
# For VPS/production use backend/.env.example instead.

SECRET_KEY=django-insecure-local-dev-only
DEBUG=True

# Leave empty to use DB_* below (recommended for local Postgres)
DATABASE_URL=

DB_NAME=bhealth_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_SUPERUSER_USERNAME=lumina-admin
DJANGO_SUPERUSER_EMAIL=admin@lumina.local
DJANGO_SUPERUSER_PASSWORD=admin123
