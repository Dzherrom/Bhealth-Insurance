# =============================================================================
# Lumina Insurance — backend environment variables
# =============================================================================
# Copy this file to backend/.env and fill in your values:
#
#   cp backend/.env.example backend/.env
#
# Never commit backend/.env (secrets). chmod 600 on the VPS.
# Generate SECRET_KEY:  openssl rand -base64 64
# URL-encode DB passwords with + / = in DATABASE_URL:
#   python3 -c "import urllib.parse; print(urllib.parse.quote('YOUR_PASSWORD', safe=''))"
# =============================================================================

# --- Required in production (VPS / Render) ------------------------------------

# Django secret signing key (required in production)
SECRET_KEY=change-me-in-production

# False on VPS and Render; True only for local debugging
DEBUG=False

# PostgreSQL connection (preferred — used on VPS and Render)
# Local VPS example:
#   DATABASE_URL=postgresql://lumina_administrator:URL_ENCODED_PASSWORD@localhost:5432/lumina_db
# Render example (external URL, ends in .render.com):
#   DATABASE_URL=postgresql://user:pass@dpg-xxxxx.virginia-postgres.render.com/dbname
DATABASE_URL=

# Public URL of this API (scheme required). Used for ALLOWED_HOSTS.
# Before domain:  http://2.25.68.83
# With domain:    https://tu-dominio.com
BACKEND_PUBLIC_URL=http://2.25.68.83

# Comma-separated frontend origins for CORS / CSRF (scheme required).
# Must match the URL you use in the browser (IP or domain).
FRONTEND_ORIGINS=http://2.25.68.83

# Extra Django ALLOWED_HOSTS (comma-separated, optional).
# Hostnames are also derived from BACKEND_PUBLIC_URL and FRONTEND_ORIGINS.
ALLOWED_HOSTS=2.25.68.83,srv1781611.hstgr.cloud

# --- Optional: PostgreSQL without DATABASE_URL (local dev only) --------------
# Used only when DATABASE_URL is empty. Prefer DATABASE_URL on the VPS.

DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Optional: first deploy superuser (ensure_crm_admin / start.sh) -----------

# DJANGO_SUPERUSER_USERNAME=lumina-admin
# DJANGO_SUPERUSER_EMAIL=admin@lumina.local
# DJANGO_SUPERUSER_PASSWORD=use-a-strong-password-in-production
#
# On VPS after migrate:
#   python manage.py ensure_crm_admin
# CRM login: /auth/login  |  Django admin: /admin/

# --- Optional: HTTPS behind Nginx (VPS with Certbot) -------------------------

# Set to False temporarily if testing HTTP-only before SSL is ready
# SECURE_SSL_REDIRECT=True

# --- Optional: third-party integrations --------------------------------------

# CONSENT_BASE_URL=https://api.example-consent.com
# CONSENT_API_KEY=
# CONSENT_WEBHOOK_SECRET=
# CONSENT_TIMEOUT_SECONDS=10
