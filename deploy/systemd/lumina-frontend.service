# Lumina Insurance — Next.js frontend
#
# Install on VPS:
#   sudo cp deploy/systemd/lumina-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable lumina-frontend
#   sudo systemctl start lumina-frontend
#
# REQUIRED before start (as deploy, NOT as www-data):
#   cd /var/www/Bhealth-Insurance/frontend
#   npm ci && npm run build
#   sudo chown -R www-data:www-data /var/www/Bhealth-Insurance/frontend
#
# Logs: sudo journalctl -u lumina-frontend -n 50 --no-pager

[Unit]
Description=Lumina Insurance Next.js Frontend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/Bhealth-Insurance/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=HOST=127.0.0.1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/www/Bhealth-Insurance/frontend
ExecStart=/usr/bin/node /var/www/Bhealth-Insurance/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumina-frontend

[Install]
WantedBy=multi-user.target

